<brls:Box
    width="auto"
    height="auto"
    axis="column"
    grow="1.0"
    paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
    paddingLeft="@style/brls/tab_frame/content_padding_sides"
    paddingRight="@style/brls/tab_frame/content_padding_sides"
    paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

	<brls:Label
        text="@i18n/akira/settings/config_view_tab"
        fontSize="30"
        marginBottom="20"/>
    
    <brls:Button
        id="config/revealBtn"
        text="@i18n/akira/config_view/reveal_secrets"
        marginBottom="15"/>

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            id="config/container"
            width="auto"
            height="auto"
            axis="column"
            grow="1.0"/>

    </brls:ScrollingFrame>

</brls:Box>
